#syntax=docker/dockerfile:1

# ── Stage 1: upstream ─────────────────────────────────────────────────────────
FROM dunglas/frankenphp:1-php8.4 AS frankenphp_upstream

# ── Stage 2: base ─────────────────────────────────────────────────────────────
FROM frankenphp_upstream AS frankenphp_base

WORKDIR /app

# hadolint ignore=DL3008
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        file \
        git \
        libcap2-bin \
    ; \
    rm -rf /var/lib/apt/lists/*; \
    install-php-extensions \
        @composer \
        apcu \
        intl \
        opcache \
        zip \
        redis \
    ;

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV PHP_INI_SCAN_DIR=":$PHP_INI_DIR/app.conf.d"

###> recipes ###
###> doctrine/doctrine-bundle ###
RUN install-php-extensions pdo_pgsql
###< doctrine/doctrine-bundle ###
###< recipes ###

RUN useradd appuser \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && mkdir -p /app/var /data/caddy /config/caddy \
    && chown -R appuser:appuser /app /data /config

VOLUME /app/var/

COPY --link frankenphp/conf.d/10-app.ini $PHP_INI_DIR/app.conf.d/
COPY --link --chmod=755 frankenphp/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
COPY --link frankenphp/Caddyfile /etc/frankenphp/Caddyfile

USER appuser

ENTRYPOINT ["docker-entrypoint"]

HEALTHCHECK --start-period=60s CMD curl http://localhost:2019/metrics --silent --show-error --fail --output /dev/null || exit 1
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]

# ── Stage 3: prod ─────────────────────────────────────────────────────────────
FROM frankenphp_base AS frankenphp_prod

ENV APP_ENV=prod

USER root

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY --link frankenphp/conf.d/20-app.prod.ini $PHP_INI_DIR/app.conf.d/

COPY --link composer.* symfony.* ./
RUN set -eux; \
    composer install --no-cache --prefer-dist --no-dev --no-autoloader --no-scripts --no-progress

COPY --link --exclude=frankenphp/ . ./

RUN set -eux; \
    mkdir -p var/cache var/log var/share; \
    composer dump-autoload --classmap-authoritative --no-dev; \
    composer dump-env prod; \
    composer run-script --no-dev post-install-cmd; \
    if [ -f importmap.php ]; then \
       php bin/console asset-map:compile; \
    fi; \
    chmod +x bin/console; \
    chown -R appuser:appuser /app /data /config; \
    sync;

USER appuser

# ── Stage 4: caprover ─────────────────────────────────────────────────────────
FROM frankenphp_prod AS caprover

USER root

# Install PostgreSQL 16, Redis, supervisord, curl (for healthcheck)
# Add PostgreSQL official apt repository (postgresql-16 not in default Debian sources)
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends gnupg2 curl ca-certificates lsb-release \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        postgresql-16 \
        redis-server \
        supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/redis \
    && chown redis:redis /var/lib/redis

COPY docker/caprover/supervisord.conf /etc/supervisor/supervisord.conf
COPY docker/caprover/supervisor.d/ /etc/supervisor/conf.d/
COPY --chmod=755 docker/caprover/entrypoint.sh /caprover-entrypoint.sh

# Persistence is configured via CapRover dashboard, not VOLUME directive
EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -s http://localhost:80/ || exit 1

ENTRYPOINT ["/caprover-entrypoint.sh"]
CMD ["supervisord", "-c", "/etc/supervisor/supervisord.conf"]
